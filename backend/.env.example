# Paste your PostgreSQL connection string below. This project targets a
# hosted Postgres instance (Neon, Supabase, Railway, etc.) — most require
# sslmode=require. A local instance works too if you swap the URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="2h"
PORT=4000
CLIENT_URL="http://localhost:5173"
